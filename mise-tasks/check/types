#!/usr/bin/env bash
#MISE description="Type-check the shipped .d.ts files, and prove each declared wasm ABI matches the generated one"
#MISE dir="{{config_root}}"
#MISE depends=["npm-install"]
#MISE tools={node="22"}
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# The .d.ts files are the public API every TypeScript consumer sees, and nothing
# used to check them: they are hand-written prose that ships to npm. This compiles
# them.
#
# The sharpest cases are `WasmCore` and `HostImports` in js/index.d.ts. They
# restate the two contracts BridgeJS generates from Swift - the exports a core
# provides (Sources/WasmBindings/Exports.swift) and the host it is instantiated
# with (Sources/JSHost/Host.swift) - because @desert-ant-labs/core is
# model-agnostic and cannot import a model package's generated
# dist/bridge-js.d.ts. Both are asserted identical here (see
# js/test/types/equal.ts for why identity and not assignability), which also
# catches a stale dist: a package built before a Swift signature changed fails.
#
# The fixture is generated rather than written, because a checked-in list of
# imports would be the one place in this repo that names the models.
fixture=js/test/types/generated.ts
cleanup() { rm -f "$fixture"; }
trap cleanup EXIT

{
    echo "// Generated by 'mise run check:types'. Not committed; see that task."
    echo 'import type { WasmCore, HostImports } from "../../index.js";'
    echo 'import type { Equal, Expect } from "./equal.js";'
} > "$fixture"

built=0
for model in $(dal_models_with node); do
    # Every model package's public entry types, so a consumer's `import { Emo }`
    # is checked and not just core's internals.
    echo "import type * as pkg_$model from \"../../../packages/$model-node/index.js\";" >> "$fixture"
    echo "export type Public_$model = keyof typeof pkg_$model;" >> "$fixture"

    abi="packages/$model-node/dist/bridge-js.d.ts"
    [ -f "$abi" ] || continue
    built=$((built + 1))
    [ -n "${first_abi:-}" ] || first_abi="$abi"
    echo "import type { Exports as Exports_$model, Imports as Imports_$model } from \"../../../$abi\";" >> "$fixture"
    echo "export type ABI_$model = Expect<Equal<WasmCore, Exports_$model>>;" >> "$fixture"
    echo "export type Host_$model = Expect<Equal<HostImports, Imports_$model>>;" >> "$fixture"
done

if [ "$built" = 0 ]; then
    echo "note: no model package has a built core, so only the .d.ts files are checked"
    echo "      (run 'mise run build:wasm' to also prove the declared wasm ABI matches)"
fi

if ! npx --yes --package typescript@5 tsc \
    --strict --noEmit --skipLibCheck false \
    --target es2022 --module nodenext --moduleResolution nodenext "$fixture"; then
    echo >&2
    echo "error: the shipped types do not check out." >&2
    if [ "$built" != 0 ] && [ -n "${first_abi:-}" ]; then
        echo "An Expect<Equal<...>> failure means the wasm ABI drifted from what Swift" >&2
        echo "exports. The generated surface, to copy into WasmCore in js/index.d.ts:" >&2
        echo >&2
        sed -n '/^export type Exports = {/,/^}/p' "$first_abi" | grep -E '^\s{4}[a-z]' >&2
    fi
    exit 1
fi

if [ "$built" != 0 ]; then
    echo "ok: the shipped .d.ts files compile, and $built built core(s) match the declared wasm ABI"
else
    echo "ok: the shipped .d.ts files compile"
fi
