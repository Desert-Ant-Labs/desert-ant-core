#!/usr/bin/env bash
#MISE description="Build the package with the oldest Swift the README promises"
#MISE dir="{{config_root}}"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"
dal_require_swift_packages

# The README promises a minimum Swift; this builds on exactly that toolchain,
# because newer syntax in code every consumer parses (`nonisolated(unsafe)` is
# 5.10, typed throws 6.0) fails a consumer's build on an older one. Same idea as
# pinning the Linux jobs to ubuntu-22.04 for glibc and the darwin native to
# macos-14: build where you promise, not where it is easy.
#
# What it covers: every file in the package is parsed here, including the
# `#if canImport(CoreML)` and `#if os(Android)` branches, because Swift parses
# inactive conditional blocks. What it does not cover: type-checking the Apple-only branches, which
# needs a Mac; the `apple` job builds those, on a newer Xcode.
floor=6.2.1
claimed=$(grep -oE 'Swift [0-9]+\.[0-9]+\+' "$MISE_PROJECT_ROOT/README.md" | head -1 | grep -oE '[0-9]+\.[0-9]+')

# The floor here and the README have to agree, or this proves the wrong thing
# quietly.
case "$floor" in
    "$claimed"*) ;;
    *)
        echo "error: this task builds with Swift $floor but README.md promises $claimed" >&2
        exit 1
        ;;
esac

# mise ships no Swift for Windows at all, so a Windows host would build this
# with whatever toolchain is on PATH and report "ok: builds on its advertised
# minimum" about a compiler that is not the minimum. Refusing to prove the
# wrong thing is the whole point of the check.
if [ "$(dal_host_os)" = windows ]; then
    echo "skip: mise cannot pin Swift $floor on Windows, and this check is only"
    echo "      meaningful on the toolchain it names. Run it on Linux or in CI."
    exit 0
fi

# The dynamic products link LiteRT, so vendor it exactly as build:swift does -
# a check that skipped linking would miss anything the linker only sees.
dal_vendor_litert
eval "$(dal_litert_link_flags)"

# macOS builds with the toolchain on PATH, as it always has; the pinned
# toolchain is a Linux matter, and the Linux jobs are where this check counts.
if [ "$(dal_host_os)" = darwin ]; then
    echo "== building with Swift $(swift --version | head -1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1), the floor README.md promises =="
    swift build --scratch-path .build-floor ${litert_flags[@]+"${litert_flags[@]}"}
    echo "ok: the package builds on its advertised minimum Swift"
    exit 0
fi

# swift.org built $floor for Ubuntu 20.04, 22.04 and 24.04, and never will for
# a newer release. mise hands any other host the 24.04 build, which on 26.04
# cannot even start: its swift-build loads libxml2.so.2, and 26.04 packages
# only libxml2.so.16. So the pin is `mise x` here rather than a #MISE tools
# header, which would download a toolchain the host cannot run, and a host
# without a native build skips: the hosted ubuntu-22.04 job proves the floor.
ubuntu=$(. /etc/os-release 2> /dev/null && [ "${ID:-}" = ubuntu ] && echo "${VERSION_ID:-}")
case "$ubuntu" in
    20.04 | 22.04 | 24.04) ;;
    *)
        echo "skip: swift.org has no Swift $floor build for this host (${ubuntu:-not Ubuntu}), and the"
        echo "      24.04 build mise would fall back to cannot load here. The hosted ubuntu-22.04"
        echo "      job in ci.yml proves the floor."
        [ -z "${GITHUB_ACTIONS:-}" ] || echo "::warning::check:swift-floor skipped: no Swift $floor for ${ubuntu:-this host}; only ci.yml's ubuntu-22.04 job proves the floor"
        exit 0
        ;;
esac
echo "== building with Swift $floor, the floor README.md promises =="
mise x "swift@$floor" -- swift build --scratch-path .build-floor ${litert_flags[@]+"${litert_flags[@]}"}
echo "ok: the package builds on its advertised minimum Swift"
