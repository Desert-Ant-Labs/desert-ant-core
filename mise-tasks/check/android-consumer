#!/usr/bin/env bash
#MISE description="Build a consumer app against the published SDKs and lint it on the SDK compiler"
#MISE dir="{{config_root}}"
#MISE depends=["android-sdk"]
#MISE tools={java="{{ vars.java }}"}
#USAGE flag "--abi <abi>" help="ABIs to build: arm64-v8a (the default), x86_64, or all"
#USAGE flag "--stage-handshake" help="Stage aligned and deliberately mismatched consumer APKs for Android instrumentation"
#USAGE flag "--handshake-abi <abi>" help="Limit the staged consumer APKs to a single ABI"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# Everything else Android here builds inside the root Gradle build, where the
# models see :core as a project. A customer's app sees Maven coordinates, POMs
# and Gradle module metadata instead, so this publishes the SDKs into a local
# repo and builds androidconsumer/ against them: every SDK, called through its
# public API from outside the build, packaged into a debug APK.
#
# The app builds with `sdk_kotlin` (kotlin in the catalog), the compiler the SDKs
# themselves build with. It must support the AGP and Gradle the fixture builds
# with (kotlinlang.org lists the ranges per release). `floor` (kotlinFloor) is
# the language, API and stdlib version every SDK module is built against, and
# the oldest Kotlin the README promises. We don't build an app on it: Kotlin's
# own compatibility guarantees cover older minor versions, so only the README
# agreement below is checked.
catalog_version() {
    sed -nE "s/^$1[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\1/p" gradle/libs.versions.toml
}
floor=$(catalog_version kotlinFloor)
sdk_kotlin=$(catalog_version kotlin)
[ -n "$floor" ] && [ -n "$sdk_kotlin" ] \
    || { echo "error: gradle/libs.versions.toml has no kotlinFloor or kotlin version" >&2; exit 1; }

# The README's promise and the floor this proves have to agree, or the check
# proves the wrong thing quietly (check:swift-floor does the same for Swift).
# `|| true`: under pipefail a README with no such line would end the task here,
# before the error below could say why.
claimed=$(grep -oE 'Kotlin [0-9]+\.[0-9]+\+' README.md | head -1 | grep -oE '[0-9]+\.[0-9]+' || true)
case "$floor" in
    "$claimed" | "$claimed".*) ;;
    *)
        echo "error: the SDKs' Kotlin floor is $floor but README.md promises Kotlin ${claimed:-(nothing)}+" >&2
        exit 1
        ;;
esac

# No Windows host lane, for the reason build:android-natives gives: publishing
# runs every model's preBuild, which is that cross-compile.
if [ "$(dal_host_os)" = windows ]; then
    echo "skip: no Windows host lane for the Android cross-compile (see build:android-natives)"
    exit 0
fi

# Exported so the publish's preBuild reuses whatever build:android just built
# instead of compiling another set of ABIs.
DAL_ANDROID_ABIS=$(dal_android_abis "${usage_abi:-}")
export DAL_ANDROID_ABIS

# Every SDK needs a caller, or a new model would pass without being checked:
# each one in the app, and the pure-Kotlin jars on the plain JVM as well. The
# fixture takes its dependencies from these two lists rather than finding the
# modules itself, so the rule for what counts as an SDK lives in one place.
fixture=androidconsumer
missing=0
app_models=()
jvm_models=()
for model in $(dal_models_with kotlin); do
    product=$(dal_product "$model")
    app_models+=("$model")
    sources=("$fixture/app/src/main/kotlin/ai/desertant/consumer/$product.kt")
    if [ ! -f "packages/$model-kotlin/src/main/AndroidManifest.xml" ]; then
        jvm_models+=("$model")
        sources+=("$fixture/jvm/src/main/kotlin/ai/desertant/consumer/$product.kt")
    fi
    for source in "${sources[@]}"; do
        [ -f "$source" ] || { echo "error: $model has no consumer source at $source" >&2; missing=1; }
    done
done
[ "$missing" = 0 ] || exit 1

# A repo of its own, emptied first, rather than ~/.m2: an artifact some earlier
# publish left there at the same version must not stand in for this tree's.
# Gradle reads maven.repo.local when it publishes and when it resolves.
repo="$PWD/$fixture/build/m2"
rm -rf "$repo"
version=$(dal_version)
echo "== publishing ai.desertant:* $version to $repo =="
# Without the javadoc and sources jars (dalPublishDocs, Support.kt): the
# fixture only compiles against the AARs and jars, and building the docs is
# about half of what the publish costs from a clean tree. Unsigned too: an
# empty signingInMemoryKey overrides one from the environment, so a key set for
# releases is never read here and never reaches the configuration cache.
./gradlew -Dmaven.repo.local="$repo" -PdalPublishDocs=false -PsigningInMemoryKey= publishToMavenLocal
app_list=$(IFS=,; echo "${app_models[*]}")
jvm_list=$(IFS=,; echo "${jvm_models[*]}")
python3 Tools/android/consumer.py verify "$repo" "$version" "$app_list" "$jvm_list"

# A real release from before the BOM with both Android ABIs and the same
# LoadedModel JVM signatures. Keep it in this repo so Central cannot hide a
# missing local candidate.
legacy=4.2.0
for model in emo core; do
    directory="$repo/ai/desertant/$model/$legacy"
    mkdir -p "$directory"
    for ext in pom module aar; do
        name="$model-$legacy.$ext"
        curl -fsSL --retry 3 "https://repo.maven.apache.org/maven2/ai/desertant/$model/$legacy/$name" -o "$directory/$name"
    done
done

consumer() {
    local kotlin=$1 consumer_repo=$2
    shift 2
    ./gradlew -p "$fixture" --no-daemon -Dmaven.repo.local="$consumer_repo" -PdalConsumerKotlin="$kotlin" \
        -PdalConsumerModels="$app_list" -PdalConsumerJvmModels="$jvm_list" "$@"
}

# --no-daemon: the fixture's Gradle needs 8 GB (androidconsumer/gradle.properties),
# and a daemon would keep it after the check ends. On CI's self-hosted runner
# that sat idle next to the emulator and the on-device run's own Gradle.
echo "== building $fixture with Kotlin $sdk_kotlin =="
consumer "$sdk_kotlin" "$repo" :app:assembleDebug :jvm:run :app:lint \
    :app:checkKotlinStdlib :jvm:checkKotlinStdlib :app:checkSdkAlignment :jvm:checkSdkAlignment
consumer "$sdk_kotlin" "$repo" -PdalConsumerMixedVersion="$legacy" :app:checkSdkAlignment
older_platform=4.2.0-bom-fixture
python3 Tools/android/consumer.py older-platform "$repo" "$version" "$older_platform"
consumer "$sdk_kotlin" "$repo" -PdalConsumerMixedVersion="$older_platform" :app:checkSdkAlignment
echo "ok: an app builds against the published SDKs on Kotlin $sdk_kotlin"

if [ -n "${usage_stage_handshake:-}" ]; then
    staged="$PWD/.build/android-compat/consumer"
    stale_repo="$PWD/$fixture/build/m2-stale-native"
    rm -rf "$staged" "$stale_repo"
    mkdir -p "$staged"
    echo "$version" > "$staged/version"
    python3 Tools/android/consumer.py stale-native "$repo" "$stale_repo" "$version" "$legacy"
    handshake_abi=()
    if [ -n "${usage_handshake_abi:-}" ]; then
        handshake_abi+=("-PdalConsumerHandshakeAbi=$usage_handshake_abi")
    fi
    for scenario in matching legacy-core stale-native; do
        scenario_repo="$repo"
        [ "$scenario" != stale-native ] || scenario_repo="$stale_repo"
        consumer "$sdk_kotlin" "$scenario_repo" -PdalConsumerLegacyVersion="$legacy" -PdalConsumerHandshake="$scenario" \
            "${handshake_abi[@]}" :handshake:assembleDebug :handshake:assembleDebugAndroidTest
        mkdir -p "$staged/$scenario"
        cp "$fixture/handshake/build/outputs/apk/debug/handshake-debug.apk" "$staged/$scenario/app.apk"
        cp "$fixture/handshake/build/outputs/apk/androidTest/debug/handshake-debug-androidTest.apk" "$staged/$scenario/test.apk"
    done
fi
