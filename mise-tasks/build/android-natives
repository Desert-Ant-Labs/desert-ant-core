#!/usr/bin/env bash
#MISE description="Cross-compile a model's Android JNI libraries into packages/<model>-kotlin/src/main/jniLibs"
#MISE dir="{{config_root}}"
#MISE tools={swift={version="6.3.3", os=["linux"]}}
#USAGE arg "<model>" help="Model to cross-compile, or 'all'" default="all"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# Invoked by the Gradle `preBuild` of each model module (see the
# ai.desertant.model-sdk convention plugin), so `mise run build:android` is the
# only entry point you normally need.
#
# Uses a static Swift stdlib, so the whole runtime is linked into a
# dead-stripped, model-specific library instead of shipping the ~10 MB dynamic
# runtime closure. The NDK C++ runtime is linked statically for the same reason.
# ai.desertant:core owns LiteRT, so each model AAR carries one library per ABI.
#
# SWIFT_ANDROID_STATIC_BUILD drops JavaScriptKit from the manifest: its
# swift-syntax macros build for the host and conflict with the -resource-dir that
# static linking needs. The wasm/JS code is all `#if os(WASI)` anyway.

# Windows hosts are out: the toolchain below is installed unattended from a
# tarball (Linux) or through swiftly (macOS), and swift.org ships it for
# Windows only as an interactive ~1 GB installer. Cross-
# compiling from a Windows host is otherwise untested; build the AARs in WSL.
if [ "$(dal_host_os)" = windows ]; then
    echo "skip: the ${DAL_SWIFT_ANDROID_SNAPSHOT:-Swift Android} toolchain has no unattended"
    echo "      Windows install; build the Android artifacts in WSL or on CI."
    exit 0
fi

api="${DAL_ANDROID_API:-24}"
export SWIFT_ANDROID_STATIC_BUILD=1

# Which ABIs to build. Ships both by default; CI's emulator is x86_64 only, so
# it sets DAL_ANDROID_ABIS=x86_64 to skip the arm64 half it would never run.
# The release workflow leaves this unset and builds everything.
abi_pairs=""
for abi in ${DAL_ANDROID_ABIS:-arm64-v8a x86_64}; do
    case "$abi" in
        arm64-v8a) abi_pairs="$abi_pairs arm64-v8a:aarch64" ;;
        x86_64) abi_pairs="$abi_pairs x86_64:x86_64" ;;
        *) echo "error: unknown ABI '$abi' in DAL_ANDROID_ABIS" >&2; exit 1 ;;
    esac
done

# Build against the official Swift Android SDK. Earlier release SDKs floored at
# API 28 (Bionic gained posix_spawn there), which is why this used a 6.4.x
# snapshot; the 6.4.1 release SDK supports API 23+, so minSdk 24 now builds on
# a released toolchain. The host toolchain and the SDK must be the same build; a
# mismatch fails with "missing required module 'SwiftAndroid'". Override the
# trio to move on (a snapshot name and its branch work the same way).
snapshot="${DAL_SWIFT_ANDROID_SNAPSHOT:-swift-6.4.1-RELEASE}"
branch="${DAL_SWIFT_ANDROID_BRANCH:-swift-6.4.1-release}"
checksum="${DAL_SWIFT_ANDROID_SDK_CHECKSUM:-a356b79f8f1daa6ae3a66f4c556966ca20c0208b3659805cf30a83a0a31d6772}"
# swiftly names a release by its version (6.4.1), a snapshot by its full name.
case "$snapshot" in
    swift-*-RELEASE) swiftly_name=${snapshot#swift-}; swiftly_name=${swiftly_name%-RELEASE} ;;
    *) swiftly_name=$snapshot ;;
esac
sdk_url="https://download.swift.org/$branch/android-sdk/$snapshot/${snapshot}_android.artifactbundle.tar.gz"

# On Linux, fetch the toolchain tarball into a cache dir (no swiftly: it has no
# packages for every distro, and CI then needs no shell setup). On macOS the
# toolchain ships as a .pkg, so use swiftly there.
if [ "$(dal_host_os)" = darwin ]; then
    command -v swiftly > /dev/null 2>&1 \
        || { echo "error: swiftly is required on macOS to install the $snapshot toolchain" >&2; exit 1; }
    swiftly list 2> /dev/null | grep -qF "$swiftly_name" || {
        echo "Installing $snapshot (one-time)..."
        swiftly install "$swiftly_name"
    }
    swift_snapshot() { swiftly run "$@" +"$swiftly_name"; }
else
    # Match the tarball to the host's Ubuntu release. The 24.04 build links
    # GLIBC 2.38 and dies on 22.04 with "version `GLIBC_2.38' not found", so
    # hardcoding one release silently ties this task to one runner image.
    ubuntu=$(. /etc/os-release 2> /dev/null && echo "${VERSION_ID:-}")
    case "$ubuntu" in
        22.04 | 24.04 | 26.04) ;;
        *) ubuntu=26.04 ;; # unknown distro: the newest build is the best guess
    esac
    toolchain="${DAL_SWIFT_TOOLCHAIN_DIR:-$HOME/.cache/desert-ant/toolchains}/$snapshot-ubuntu$ubuntu"
    if [ ! -x "$toolchain/usr/bin/swift" ]; then
        echo "Installing the $snapshot host toolchain for ubuntu$ubuntu (one-time, ~1.2 GB)..."
        mkdir -p "$toolchain"
        curl -fSL "https://download.swift.org/$branch/ubuntu${ubuntu/./}/$snapshot/$snapshot-ubuntu$ubuntu.tar.gz" \
            | tar -xz -C "$toolchain" --strip-components=1
    fi
    [ -x "$toolchain/usr/bin/swift" ] \
        || { echo "error: the $snapshot toolchain is not usable at $toolchain" >&2; exit 1; }
    swift_snapshot() { "$toolchain/usr/bin/$@"; }
fi

# The NDK: SwiftPM takes its sysroot from ANDROID_NDK_HOME, and the C++ runtime
# below comes from the same NDK. The 6.4.1 SDK's static runtime is built against
# LLVM 21's libc++ and needs std::__hash_memory, which only NDK r30's libc++
# defines (r27 to r29 fail the link). Use an installed r30+, else install the
# pinned one next to the host toolchain, where CI's toolchain cache keeps it.
ndk_min=30
ndk_pin="${DAL_ANDROID_NDK_VERSION:-30.0.16248370}"
ndk_cache="${DAL_SWIFT_TOOLCHAIN_DIR:-$HOME/.cache/desert-ant/toolchains}/android-sdk"
ndk_major() { sed -n 's/^Pkg.Revision = \([0-9]*\).*/\1/p' "$1/source.properties" 2> /dev/null; }
ndk=""
for candidate in "${ANDROID_NDK_HOME:-}" "$ndk_cache"/ndk/* "${ANDROID_HOME:-$HOME/Android/Sdk}"/ndk/* \
    "$HOME"/Library/Android/sdk/ndk/*; do
    [ -n "$candidate" ] && [ -d "$candidate" ] || continue
    major=$(ndk_major "$candidate")
    [ -n "$major" ] && [ "$major" -ge "$ndk_min" ] || continue
    [ -z "$ndk" ] || [ "$major" -gt "$(ndk_major "$ndk")" ] && ndk=$candidate
done
if [ -z "$ndk" ]; then
    sdk_root="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}}"
    sdkmanager=$(ls "$sdk_root"/cmdline-tools/*/bin/sdkmanager "$HOME"/Library/Android/sdk/cmdline-tools/*/bin/sdkmanager \
        2> /dev/null | head -1 || true)
    [ -n "$sdkmanager" ] || { echo "error: no Android NDK r$ndk_min+ and no sdkmanager to install $ndk_pin" >&2; exit 1; }
    echo "Installing Android NDK $ndk_pin into $ndk_cache (one-time, ~1 GB)..."
    mkdir -p "$ndk_cache"
    yes | "$sdkmanager" --sdk_root="$ndk_cache" --licenses > /dev/null 2>&1 || true
    "$sdkmanager" --sdk_root="$ndk_cache" "ndk;$ndk_pin" > /dev/null
    ndk="$ndk_cache/ndk/$ndk_pin"
fi
export ANDROID_NDK_HOME="$ndk"
echo "Android NDK: $ANDROID_NDK_HOME"

find_bundle() {
    local dir bundle
    while IFS= read -r dir; do
        # _android specifically: a persistent runner also holds the wasm bundle
        # for the same Swift version, and a bare *$snapshot* glob picks whichever
        # is newest (the wasm one has no Android sysroot, so libc++_static.a for
        # an Android arch is then "not found").
        bundle=$(ls -dt "$dir"/*"$snapshot"*_android.artifactbundle 2> /dev/null | head -1 || true)
        [ -n "$bundle" ] && { echo "$bundle"; return 0; }
    done < <(dal_swift_sdk_dirs)
    return 1
}
bundle=$(find_bundle || true)
if [ -z "$bundle" ]; then
    echo "Installing the official Android SDK for $snapshot (one-time, ~330 MB)..."
    swift_snapshot swift sdk install "$sdk_url" --checksum "$checksum"
    bundle=$(find_bundle || true)
fi
[ -n "$bundle" ] || { echo "error: no Android SDK bundle for $snapshot after install" >&2; exit 1; }

# SwiftPM 6.4 needs an NDK when targeting android triples; see dal_android_ndk.
ANDROID_NDK_HOME=$(dal_android_ndk)
export ANDROID_NDK_HOME ANDROID_NDK_ROOT="$ANDROID_NDK_HOME"

# SwiftPM matches an SDK by triple (or id) across every search path, and a host
# that still has an older snapshot's bundle, or this bundle under a second SDK
# directory, then matches several and either refuses to pick or picks an
# unconfigured copy. Building against a directory holding only this bundle is
# the only disambiguation that holds; same reasoning as mise-tasks/test/android.
sdkroot=".build-android/swift-sdks"
rm -rf "$sdkroot" && mkdir -p "$sdkroot"
ln -sfn "$bundle" "$sdkroot/$(basename "$bundle")"

# LiteRT android libs, used only while linking each ABI. ai.desertant:core owns
# the copies that are actually packaged into an app.
# Android is pinned on its own: Maven has releases PyPI (the desktop source) does
# not. A stamp refetches the libs when the version changes.
litert_version="${DAL_LITERT_ANDROID_VERSION:-2.3.2}"
if [ ! -f Vendor/litert/lib/android-aarch64/libLiteRt.so ] \
    || [ ! -f Vendor/litert/lib/android-x86_64/libLiteRt.so ] \
    || [ "$(cat Vendor/litert/lib/android-version 2> /dev/null)" != "$litert_version" ]; then
    echo "Fetching the LiteRT $litert_version android libs (one-time)..."
    tmp=$(mktemp -d)
    curl -fSL -o "$tmp/litert.aar" \
        "https://dl.google.com/dl/android/maven2/com/google/ai/edge/litert/litert/$litert_version/litert-$litert_version.aar"
    ( cd "$tmp" && unzip -qo litert.aar )
    for pair in arm64-v8a:aarch64 x86_64:x86_64; do
        mkdir -p "Vendor/litert/lib/android-${pair#*:}"
        cp "$tmp/jni/${pair%:*}/libLiteRt.so" "Vendor/litert/lib/android-${pair#*:}/libLiteRt.so"
    done
    echo "$litert_version" > Vendor/litert/lib/android-version
    rm -rf "$tmp"
fi

# Strip tool: llvm-strip/llvm-objcopy from PATH or the Swift toolchain bin, else
# the NDK's. Both handle Android ELF from any host.
strip_bin="" strip_mode=""
swift_bin=$(dirname "$(command -v swift || echo /nonexistent/swift)")
for candidate in llvm-strip "$swift_bin/llvm-strip" llvm-objcopy "$swift_bin/llvm-objcopy"; do
    if command -v "$candidate" > /dev/null 2>&1; then
        strip_bin=$(command -v "$candidate")
        case "$candidate" in *objcopy) strip_mode=objcopy ;; *) strip_mode=strip ;; esac
        break
    fi
done
if [ -z "$strip_bin" ]; then
    for base in "$bundle" "$HOME"/.swiftpm/swift-sdks/* "${ANDROID_NDK_HOME:-/nonexistent}" \
        "${ANDROID_HOME:-$HOME/Android/Sdk}/ndk" "$HOME/Library/Android/sdk/ndk"; do
        candidate=$(find "$base" -name llvm-strip 2> /dev/null | head -1 || true)
        [ -n "$candidate" ] && { strip_bin=$candidate; strip_mode=strip; break; }
    done
fi

for model in $(dal_select "${usage_model:-all}" kotlin); do
    # A pure-Kotlin module (no AndroidManifest.xml) is a plain JVM jar: no JNI
    # library to cross-compile.
    if [ ! -f "packages/$model-kotlin/src/main/AndroidManifest.xml" ]; then
        echo "== $model is pure Kotlin, no natives =="
        continue
    fi
    product=$(dal_product "$model")
    jni_libs="packages/$model-kotlin/src/main/jniLibs"

    for pair in $abi_pairs; do
        abi=${pair%:*} arch=${pair#*:}
        echo "== $product $abi ($arch) =="

        # No -resource-dir override: the SDK descriptor declares sdkRootPath and
        # swiftStaticResourcesPath per triple and SwiftPM applies the static one.
        # Overriding it by hand clobbers the sysroot association and breaks the
        # Android overlay's SwiftAndroid module.
        #
        # Swift's static runtime response file asks for the C++ standard library
        # by driver alias, so the NDK archive goes under every alias a model AAR
        # could otherwise collide over.
        cxx=$(find -L "$bundle" -path "*$arch-linux-android*" -name libc++_static.a 2> /dev/null | head -1 || true)
        if [ -z "$cxx" ]; then
            for base in "${ANDROID_NDK_HOME:-/nonexistent}" "${ANDROID_HOME:-$HOME/Android/Sdk}/ndk" \
                "$HOME/Library/Android/sdk/ndk"; do
                cxx=$(find -L "$base" -path "*$arch-linux-android*" -name libc++_static.a 2> /dev/null | head -1 || true)
                [ -n "$cxx" ] && break
            done
        fi
        [ -n "$cxx" ] || { echo "error: libc++_static.a for $arch not found" >&2; exit 1; }
        cxx_dir=$(mktemp -d)
        for alias in libc++.a libc++_shared.a libstdc++.a libstdc++_shared.a; do
            ln -s "$cxx" "$cxx_dir/$alias"
        done
        # libc++_static.a is only half of the C++ runtime: the ABI library next
        # to it defines __cxa_pure_virtual and the rest of the Itanium ABI, and
        # libunwind backs its exception handling. Leaving them out still links
        # (a shared object may carry undefined symbols) and then fails at
        # dlopen on the device.
        extra_libs=()
        for name in libc++abi.a libunwind.a; do
            found=$(find -L "$(dirname "$cxx")" -maxdepth 1 -name "$name" 2> /dev/null | head -1 || true)
            [ -n "$found" ] && extra_libs+=(-Xlinker "$found")
        done

        # --static-swift-stdlib (SwiftPM), not -Xswiftc -static-stdlib: the
        # latter only tells the compiler, so SwiftPM still resolves the dynamic
        # swift-<arch> resources dir and the driver cannot find
        # android/static-stdlib-args.lnk, which only exists under swift_static-.
        #
        # --no-undefined turns a missing runtime symbol into a link error here
        # instead of an UnsatisfiedLinkError on a user's phone.
        swift_snapshot swift build --scratch-path .build-android -c release \
            --product "${product}Android" \
            --swift-sdks-path "$sdkroot" --swift-sdk "$arch-unknown-linux-android$api" \
            --static-swift-stdlib \
            -Xlinker "-LVendor/litert/lib/android-$arch" -Xlinker "-L$cxx_dir" \
            ${extra_libs[@]+"${extra_libs[@]}"} -Xlinker --no-undefined
        rm -rf "$cxx_dir"

        dest="$jni_libs/$abi"
        rm -rf "$dest" && mkdir -p "$dest"
        # Locate the library rather than hardcoding a layout: Swift 6.4 emits
        # .build/out/Products/Release-android-<arch>/, older SwiftPM used
        # .build/<triple>/release/. Both spell the arch.
        built=$(find .build-android -type f -name "lib${product}Android.so" -path "*$arch*" 2> /dev/null | head -1)
        [ -n "$built" ] \
            || { echo "error: lib${product}Android.so for $arch not found under .build-android" >&2; exit 1; }
        cp "$built" "$dest/"

        so="$dest/lib${product}Android.so"
        case "$strip_mode" in
            objcopy) "$strip_bin" --strip-unneeded "$so" "$so.stripped" && mv "$so.stripped" "$so" ;;
            strip) "$strip_bin" --strip-unneeded "$so" ;;
            *) echo "warning: no LLVM strip tool found; shipping an unstripped library" >&2 ;;
        esac
    done

    # The AAR ships no model: it downloads the pinned revision on first use.
    # Remove anything an older build staged into the AAR's classpath resources.
    rm -rf "packages/$model-kotlin/src/main/resources"
    du -sh "$jni_libs"
done
