#!/usr/bin/env bash
#MISE description="Build each model's native Node core into packages/<model>-node/native/<platform>-<arch>"
#MISE dir="{{config_root}}"
#USAGE arg "<model>" help="Model to build, or 'all'" default="all"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# The npm package is isomorphic: browsers get the WebAssembly + LiteRT.js build
# (build:wasm), Node gets this prebuilt native core - the <Product>Node product,
# which is the C ABI in CABI.swift. koffi binds <model>_* over it.
#
# Cross-OS builds are not possible, so this runs on each target OS and the
# release gathers the results. Backends match the rest of the SDK: Linux links
# the vendored LiteRT and a static Swift+Foundation so the .so is
# self-contained; macOS uses Core ML against the OS-provided runtime.
#
# Three Linux distribution rules:
#   * build against glibc <= 2.28 and libstdc++ <= GLIBCXX_3.4.25, the
#     manylinux_2_28 floor the vendored x86_64 LiteRT wheel already sets. Both
#     are only forward-compatible, so the build host's versions become the
#     package's floor. The release runs this inside a swift:*-amazonlinux2
#     image (glibc 2.26, GLIBCXX_3.4.24, which also supplies the Swift
#     toolchain - hence no mise swift pin above), so the x64 natives load on
#     Ubuntu 20.04+, Debian 11+ and AWS Lambda's Amazon Linux 2023. rhel-ubi9
#     (2.34) produces natives Ubuntu 20.04 cannot load. arm64 is held at 2.34 by its LiteRT wheel, not by this build.
#     Guarded by the ceiling check below;
#   * link `-z nodelete` so the process does not dlclose the static Swift
#     runtime at shutdown, which segfaults on natural exit on some glibc builds;
#   * route libcurl through Tools/curlcompat instead of linking it, which
#     opens the host's libcurl itself with RTLD_DEEPBIND. Linked directly, the
#     .so fails to load on libcurl < 7.86 (the image's Foundation was compiled
#     against libcurl 8), crashes its first download on < 7.84, and segfaults
#     on Ubuntu 20.04 because that libcurl's OpenSSL 1.1 binds to the OpenSSL 3
#     Node exports. The file says more; the check after the ceilings guards it.

# No Windows lane: the npm packages ship natives for linux-x64, linux-arm64 and
# darwin-arm64 (the three js/src/native.js names), and nothing consumes a
# win32-x64 core today. Not a toolchain limit - `swift build --product
# <Product>Node` does produce <Product>Node.dll on a Windows host, which
# js/src/native.js already knows how to name - but shipping it is a packaging
# decision, so this skips rather than staging an artifact no package declares.
if [ "$(dal_host_os)" = windows ]; then
    echo "skip: the npm packages ship no win32-x64 native core"
    exit 0
fi

dal_vendor_litert
arch=$(dal_arch)

# --disable-default-traits is rejected on a package that declares no traits, so
# only pass it when the manifest has some. Models small enough to bundle declare
# a BundledModel trait, disabled here since the npm package ships no SwiftPM
# resource bundle.
#
# `${arr[@]+"${arr[@]}"}` rather than `"${arr[@]}"`: macOS ships bash 3.2, where
# expanding an empty array under `set -u` is an "unbound variable" error.
traits=()
grep -q "traits:" Package.swift && traits=(--disable-default-traits)

for model in $(dal_select "${usage_model:-all}" node); do
    if dal_node_wasm_only "$model"; then
        echo "== $model has no native core, only wasm =="
        continue
    fi
    if dal_node_pure "$model"; then
        echo "== $model is pure, no native core =="
        continue
    fi
    product=$(dal_product "$model")
    echo "== ${product}Node =="

    if [ "$(dal_host_os)" = darwin ]; then
        dest="packages/$model-node/native/darwin-$arch"
        rm -rf "$dest" && mkdir -p "$dest"
        swift build --scratch-path .build-host -c release --product "${product}Node" ${traits[@]+"${traits[@]}"} \
            -Xlinker -rpath -Xlinker @loader_path
        cp ".build-host/release/lib${product}Node.dylib" "$dest/"
        # -x drops local symbols; the exported <model>_* C ABI koffi binds
        # lives in the export table, which strip never touches.
        strip -x "$dest/lib${product}Node.dylib"
    else
        dest="packages/$model-node/native/linux-$arch"
        rm -rf "$dest" && mkdir -p "$dest"
        # Static Foundation on Linux autolinks -lcurl/-lxml2/-lz; provide
        # dev-name symlinks to the runtime sonames (the recorded DT_NEEDED stays
        # the soname, which is present on any normal Linux). libcurl gets an
        # empty linker script instead: dal_curl_compat.o defines every call, so
        # the autolinked -lcurl must add nothing, not even a DT_NEEDED. Neither
        # --as-needed nor an AS_NEEDED script does that reliably, because
        # -Xlinker puts the object after -lcurl on the link line.
        stub=$(mktemp -d)
        ldc=$(command -v ldconfig || echo /sbin/ldconfig)
        for soname in libxml2.so.2 libz.so.1; do
            src=$("$ldc" -p 2> /dev/null | awk -v n="$soname" '$1 == n { print $NF; exit }' || true)
            [ -n "$src" ] && ln -sf "$src" "$stub/${soname%%.so*}.so"
        done
        echo "/* libcurl is opened at run time by Tools/curlcompat */" > "$stub/libcurl.so"
        cc -c -fPIC -O2 -o "$stub/dal_curl_compat.o" Tools/curlcompat/dal_curl_compat.c
        litert=$(dal_litert_dir)
        swift build --scratch-path .build-host -c release --product "${product}Node" ${traits[@]+"${traits[@]}"} \
            -Xswiftc -static-stdlib \
            -Xlinker "-L$stub" -Xlinker "-L$litert" -Xlinker -rpath -Xlinker '$ORIGIN' \
            -Xlinker -z -Xlinker nodelete -Xlinker "$stub/dal_curl_compat.o"
        rm -rf "$stub"
        cp ".build-host/release/lib${product}Node.so" "$dest/"
        cp "$litert/libLiteRt.so" "$dest/"
        # Ships beside the natives for hosts with no /sys/devices/system/cpu to
        # LD_PRELOAD; nothing links it.
        cc -shared -fPIC -O2 -o "$dest/libdalcpushim.so" Tools/cpushim/dal_cpu_shim.c -ldl
        # The npm package needs no .debug_info/.symtab; koffi resolves the
        # <model>_* C ABI through .dynsym, which stripping keeps.
        strip --strip-unneeded "$dest/lib${product}Node.so" "$dest/libdalcpushim.so"
        # Distribution floor guard: fail loudly if any shipped lib picked up a
        # glibc or libstdc++ symbol newer than manylinux_2_28 provides. arm64
        # starts higher and nothing here can lower it: Google's aarch64 LiteRT
        # wheel is tagged manylinux_2_28 but its libLiteRt.so links glibc 2.34
        # and GLIBCXX_3.4.30, so arm64 needs Ubuntu 22.04 or AL2023 anyway.
        # DAL_GLIBC_CEILING and DAL_GLIBCXX_CEILING loosen it for builds that
        # are never published (ci.yml's test-only natives build on newer
        # hosts); the release workflow builds on glibc 2.26 and keeps the
        # defaults.
        glibc_ceiling=2.28 glibcxx_ceiling=3.4.25
        [ "$arch" = arm64 ] && glibc_ceiling=2.34 glibcxx_ceiling=3.4.30
        for check in "GLIBC_:${DAL_GLIBC_CEILING:-$glibc_ceiling}" "GLIBCXX_:${DAL_GLIBCXX_CEILING:-$glibcxx_ceiling}"; do
            prefix=${check%%:*} ceiling=${check#*:}
            for lib in "$dest"/*.so; do
                # `|| true`: a C lib has no GLIBCXX_ at all, and grep's miss
                # would end the task under pipefail.
                max=$(objdump -T "$lib" | { grep -o "${prefix}[0-9.]*" || true; } | sed "s/${prefix}//" | sort -uV | tail -1)
                if [ -n "$max" ] && [ "$(printf '%s\n' "$max" "$ceiling" | sort -V | tail -1)" != "$ceiling" ]; then
                    echo "error: $(basename "$lib") requires ${prefix}$max > $ceiling; build on an older glibc" >&2
                    exit 1
                fi
            done
        done
        if grep -q 'NEEDED.*libcurl' <<< "$(objdump -p "$dest/lib${product}Node.so")" \
            || grep -q 'UND.* curl_' <<< "$(objdump -T "$dest/lib${product}Node.so")"; then
            echo "error: lib${product}Node.so links libcurl directly; add the missing calls to Tools/curlcompat" >&2
            exit 1
        fi
        # js/src/native.js asks this before anything else to turn a missing
        # libcurl into an error from load() instead of an abort.
        # Not `objdump | grep -q`: grep exiting at the first match leaves
        # objdump to die of SIGPIPE, which pipefail reports as a miss.
        if ! grep -q '\.text.* dal_curl_available$' <<< "$(objdump -T "$dest/lib${product}Node.so")"; then
            echo "error: lib${product}Node.so does not export dal_curl_available" >&2
            exit 1
        fi
    fi
    ls -la "$dest"
done
