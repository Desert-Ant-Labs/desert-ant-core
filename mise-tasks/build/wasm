#!/usr/bin/env bash
#MISE description="Build each model's WebAssembly core into packages/<model>-node/dist"
#MISE dir="{{config_root}}"
#MISE tools={swift="6.3.3", "aqua:WebAssembly/binaryen"="130", node="22"}
#USAGE arg "<model>" help="Model to build, or 'all'" default="all"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# This is the browser artifact: the npm package's default entry loads it. The
# Swift SDK for WebAssembly installs on demand; wasm-opt comes from mise.
#
# DAL_WASM_BUILD adds JavaScriptKit to the manifest, which is what declares the
# *Web products at all (see Package.swift). It is opt-in so non-wasm consumers
# never resolve it and build its swift-syntax macros.
#
# node is a build-time tool here, not just a test tool: the BridgeJS plugin that
# generates the JS glue and .d.ts for a model's `@JS` entry points shells out to
# it, and fails the build with a config hint if it is not on PATH.
export DAL_WASM_BUILD=1

# SwiftPM checks JavaScriptKit out with libgit2 and that tree carries symlinks,
# so a Windows host without the symlink privilege dies in a wall of "unable to
# create symlink ... Permission denied" before a line is compiled. Say what is
# missing instead, and skip: everything else in `mise run build` still runs.
if ! dal_can_symlink; then
    echo "skip: this host cannot create symbolic links, which SwiftPM needs to check out"
    echo "      JavaScriptKit. Turn on Settings > System > For developers > Developer Mode"
    echo "      (it grants SeCreateSymbolicLinkPrivilege), start a new shell, and re-run."
    echo "      Note the swift pin above is a no-op on Windows - mise has no Swift there -"
    echo "      so this will then run on whatever toolchain is on PATH, and only a version"
    echo "      that swift.org publishes a wasm SDK for will get past dal_wasm_sdk."
    exit 0
fi

sdk=$(dal_wasm_sdk)

# Every model with a Web entry, not just the ones with an npm package: a *Web
# product that stops compiling should fail here rather than the first time
# someone packages it.
#
# Four phases rather than one loop: one plugin build in the default scratch
# path to bring the shared graph and the host tooling up to date, then the
# rest of the plugin builds fanned out over worker scratch paths, then the
# wasm-opt passes (independent single-threaded jobs of about a minute each),
# then staging.
#
# No whole-package prebuild: the js plugin adds its own global flags to every
# build it drives (-static-stdlib, the reactor exec model, the
# __main_argc_argv export), and SwiftPM keys its build database on the exact
# command line, so a prebuild in any other configuration churns the graph.
# The fan-out sidesteps that: every invocation is the same plugin build, just
# against its own scratch path.
#
# The workers exist because the per-product cost is a serial wasm-ld link of
# the whole static core, about half a minute each on a CI runner, which for a
# dozen products is minutes of one core linking while the rest idle. Any edit
# to a shared module relinks every product, so a warm .build does not help.
# Each worker scratch is seeded once by copying .build; the copy's first
# build rebuilds the host tools (llbuild keys on absolute paths, and clang's
# precompiled modules record the cache path they were built under), so the
# seed costs about a minute, once, after which the worker is incremental like
# any scratch path. CI caches the worker dirs alongside .build so that price
# is paid per cache miss, not per run.
#
# --scratch-path is safe here: the js plugin's known mislocation under a
# custom scratch path is in its `test` subcommand, and the build path
# resolves the artifact from SwiftPM's own build result. The --output dir
# stays under the default .build for every worker, which the staging and
# wasm-opt phases below rely on.
build_one() { # product scratch-args...
    local product=$1; shift
    # jobs is set below once the lane count is known: concurrent lanes must
    # split the cores, or the one-time seed rebuilds (swift-syntax for the
    # BridgeJS host tools, about a gigabyte per frontend job) OOM a small
    # runner when every lane spawns nproc frontends at once.
    set -- -j "${jobs:-1}" "$@"
    # --allow-writing-to-package-directory: the plugin writes its output under
    # .build/, which SwiftPM's plugin sandbox blocks on macOS without it.
    #
    # --no-optimize: the plugin would run its own wasm-opt pass per model,
    # serially; the parallel pass below covers every binary with a fuller flag
    # set, so the plugin's is wasted work.
    swift package "$@" -Xswiftc -Osize --swift-sdk "$sdk" --allow-writing-to-package-directory \
        js --product "${product}Web" -c release --no-optimize --output ".build/wasm-package/$product"
}

queue=""
for model in $(dal_select "${usage_model:-all}"); do
    product=$(dal_product "$model")
    [ -d "Sources/$product/Web" ] || { echo "== $product has no wasm entry, skipping =="; continue; }
    queue="$queue $model"
done
queued=$(echo "$queue" | wc -w | tr -d ' ')

# Lane count: the links are single-threaded, so one lane per core up to 4,
# where the duplicated recompiles across the worker scratches stop paying for
# themselves. DAL_WASM_JOBS=1 restores the fully serial build.
lanes=${DAL_WASM_JOBS:-$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 1)}
[ "$lanes" -gt 4 ] && lanes=4
[ "$lanes" -gt "$queued" ] && lanes=$queued
[ "$lanes" -lt 1 ] && lanes=1

cores=$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 1)
jobs=$cores

built=""
first=${queue# }
first=${first%% *}
if [ "$queued" -gt 0 ]; then
    # The first product runs alone in the default scratch path: it builds the
    # shared graph and the BridgeJS host tooling once, so the workers seed from
    # a warm .build and the fan-out is links, not a compile stampede.
    product=$(dal_product "$first")
    echo "== ${product}Web =="
    build_one "$product"
    built="$built $first"
fi

if [ "$queued" -gt 1 ]; then
    rest=${queue#* "$first"}
    jobs=$(((cores + lanes - 1) / lanes))
    logdir=.build/wasm-logs
    rm -rf "$logdir" && mkdir -p "$logdir"
    pids=""
    for lane in $(seq 1 "$lanes"); do
        scratch="" # lane 1 reuses the default .build
        if [ "$lane" -gt 1 ]; then
            worker=.build-wasm-workers/$((lane - 1))
            if [ ! -d "$worker" ]; then
                echo "== seeding worker scratch $worker (one-time) =="
                mkdir -p .build-wasm-workers
                cp -a .build "$worker"
                # Drop the copied outputs of the earlier plugin runs, and
                # clang's module caches, whose .pcm files refuse to load from
                # any path but the one they were built under.
                rm -rf "$worker/wasm-package" "$worker/wasm-logs" "$worker"/*/*/ModuleCache
            fi
            scratch=$worker
        fi
        # Round-robin over the remaining products: lane N takes the Nth, then
        # every lanes-th after it.
        (
            i=0
            for m in $rest; do
                if [ $((i % lanes)) -eq $((lane - 1)) ]; then
                    p=$(dal_product "$m")
                    echo "== ${p}Web (lane $lane) =="
                    if [ -n "$scratch" ]; then
                        build_one "$p" --scratch-path "$scratch"
                    else
                        build_one "$p"
                    fi
                fi
                i=$((i + 1))
            done
        ) > "$logdir/lane-$lane.log" 2>&1 &
        pids="$pids $!:$lane"
    done
    failed=0
    for entry in $pids; do
        pid=${entry%%:*} lane=${entry##*:}
        if ! wait "$pid"; then
            echo "error: wasm build lane $lane failed" >&2
            failed=1
        fi
        cat "$logdir/lane-$lane.log"
    done
    [ "$failed" -eq 0 ] || exit 1
    built="$built $rest"
fi

if command -v wasm-opt > /dev/null; then
    pids=()
    for model in $built; do
        product=$(dal_product "$model")
        out=.build/wasm-package/$product
        wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int \
            --enable-sign-ext --enable-reference-types --strip-debug --strip-producers \
            "$out/${product}Web.wasm" -o "$out/${product}Web.wasm" &
        pids+=($!)
    done
    for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid"; done
else
    echo "warning: wasm-opt not found; shipping unoptimized wasm (~3x larger)" >&2
fi

for model in $built; do
    product=$(dal_product "$model")
    out=.build/wasm-package/$product

    # Models without an npm package are a compile check only; there is nowhere
    # to stage the artifact.
    dist=packages/$model-node/dist
    if [ ! -d "packages/$model-node" ]; then
        ls -la "$out/${product}Web.wasm"
        echo "($model ships no npm package yet: compiled, not staged)"
        continue
    fi

    rm -rf "$dist"
    mkdir -p "$dist"
    # bridge-js.{js,d.ts} are the BridgeJS-generated glue and types for the
    # model's `@JS` surface; instantiate.js imports the former, and the latter is
    # what makes that surface typed for a TypeScript consumer.
    cp "$out/${product}Web.wasm" "$out"/index.js "$out"/index.d.ts \
        "$out"/instantiate.js "$out"/instantiate.d.ts "$out"/runtime.js "$out"/runtime.d.ts \
        "$out"/bridge-js.js "$out"/bridge-js.d.ts "$dist/"
    cp -r "$out"/platforms "$dist/platforms"
    # The npm tarball must carry the license (package.json: SEE LICENSE IN ...).
    cp LICENSE.md "packages/$model-node/LICENSE.md"

    ls -la "$dist/${product}Web.wasm"
done
