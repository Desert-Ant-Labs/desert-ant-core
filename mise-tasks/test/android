#!/usr/bin/env bash
#MISE description="Run the on-device Android tests on a connected emulator or device"
#MISE dir="{{config_root}}"
#MISE depends=["android-sdk"]
#MISE tools={swift="{{ vars.swift }}", java="temurin-21"}
#USAGE arg "<model>" help="Also run this model AAR's instrumented tests, or 'all'" default="all"
#USAGE flag "--core-only" help="Only run the core host-bridge harness, no model AARs"
#USAGE flag "--stage-only" help="Only cross-compile and stage the JNI harness, no device needed"
#USAGE flag "--no-stage" help="Skip staging; run against jniLibs a prior --stage-only produced"
#USAGE flag "--abi <abi>" help="ABIs to stage and build: arm64-v8a (the default), x86_64, or all"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"
dal_require_swift_packages

# Android is the one platform `swift test` cannot cover: there the JSON, Regex,
# and TextNormalization backends call the host through CHostBridge callbacks that
# a JVM installs, so those paths only execute with a real JVM attached. This
# cross-compiles the JNI harness (Sources/CoreAndroidTests) into androidtest/ and
# runs it on a device, then runs each model AAR's own instrumented suite.
#
# A pinned swift.org toolchain: the Android cross-compilation SDK only exists for
# released Swift versions. Own scratch dir (.build-androidtest) so toolchains
# never share one: build:android-natives owns .build-android with its own
# swift.org tarball of the same release, and reusing its scratch state from
# mise's copy breaks the C targets' header search (stdlib.h not found).
api="${DAL_ANDROID_API:-31}"
export SWIFT_ANDROID_STATIC_BUILD=1 # drops JavaScriptKit (host macros) from the graph

# Which ABIs to stage: --abi, else DAL_ANDROID_ABIS, else arm64-v8a (see
# dal_android_abis). CI's emulator is x86_64, so CI sets that. Exported so the
# model AARs Gradle builds below (preBuild -> build:android-natives) match.
abis=$(dal_android_abis "${usage_abi:-}")
export DAL_ANDROID_ABIS="$abis"

if [ -z "${usage_stage_only:-}" ]; then
    adb="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}/platform-tools/adb"
    [ -x "$adb" ] || adb=adb
    "$adb" devices 2> /dev/null | sed 1d | grep -qw device || {
        echo "error: no Android device or emulator is connected." >&2
        echo "       Start one (Android Studio, or 'emulator -avd <name>'); CI uses" >&2
        echo "       reactivecircus/android-emulator-runner." >&2
        exit 1
    }
fi

jni=androidtest/src/main/jniLibs
if [ -n "${usage_no_stage:-}" ]; then
    find "$jni" -name libCoreAndroidTests.so 2> /dev/null | grep -q . || {
        echo "error: --no-stage, but nothing is staged in $jni. Run" >&2
        echo "       'mise run test:android --stage-only' first." >&2
        exit 1
    }
else
# Match the Android SDK bundle to the toolchain version, installing from the
# downloaded file so no per-version checksum has to be pinned here.
swift_version=$(dal_swift_version)
bundle_name="swift-$swift_version-RELEASE_android.artifactbundle"
find_bundle() {
    local dir
    for dir in "$HOME/.swiftpm/swift-sdks" "$HOME/.config/swiftpm/swift-sdks" "$HOME/Library/org.swift.swiftpm/swift-sdks"; do
        [ -d "$dir/$bundle_name" ] && { echo "$dir/$bundle_name"; return 0; }
    done
    return 1
}
bundle=$(find_bundle || true)
if [ -z "$bundle" ]; then
    echo "Installing the Swift Android SDK $swift_version (one-time)..."
    tmp=$(mktemp -d)
    curl -fSL -o "$tmp/sdk.tar.gz" \
        "https://download.swift.org/swift-$swift_version-release/android-sdk/swift-$swift_version-RELEASE/$bundle_name.tar.gz"
    swift sdk install "$tmp/sdk.tar.gz"
    rm -rf "$tmp"
    bundle=$(find_bundle || true)
fi
[ -n "$bundle" ] || { echo "error: the Swift Android SDK was not found after install" >&2; exit 1; }

# The NDK: SwiftPM 6.4 takes its sysroot from ANDROID_NDK_HOME, and the
# libc++_shared.so staged below comes from the same NDK, the one
# ANDROID_NDK_VERSION pins (one copy on disk, see dal_android_ndk). Configure the
# bundle against it once: the marker is a ndk-sysroot whose symlinked headers
# point into this NDK and resolve (a restored cache can leave dangling links, an
# earlier pin an older NDK).
ANDROID_NDK_HOME=$(dal_android_ndk)
export ANDROID_NDK_HOME ANDROID_NDK_ROOT="$ANDROID_NDK_HOME"
echo "Android NDK: $ANDROID_NDK_HOME"
sysroot="$bundle/swift-android/ndk-sysroot"
case "$(readlink "$sysroot/usr/include" 2> /dev/null)" in
    "$ANDROID_NDK_HOME"/*) [ -e "$sysroot/usr/include/stdlib.h" ] || sysroot="" ;;
    *) sysroot="" ;;
esac
if [ -z "$sysroot" ]; then
    echo "Configuring the SDK against the Android NDK $(dal_android_ndk_version) (one-time)..."
    ( cd "$bundle/swift-android" && ./scripts/setup-android-sdk.sh )
fi

# SwiftPM matches an SDK by triple across every search path, and the snapshot
# SDK build:android-natives installs matches the Android triple just as well as
# the release one resolved above - so the pick is arbitrary, and picking the
# snapshot against this task's toolchain fails to find its sysroot ('stdlib.h'
# file not found). Neither an id nor a triple disambiguates: the id also matches
# every arch in the bundle, and the same bundle is installed under more than one
# SDK directory. Building against a directory holding only this bundle does.
sdkroot=".build-androidtest/swift-sdks"
rm -rf "$sdkroot" && mkdir -p "$sdkroot"
ln -sfn "$bundle" "$sdkroot/$(basename "$bundle")"

# Cross-compile the JNI harness per ABI and stage it (plus the NDK's
# libc++_shared.so) into the Gradle module's jniLibs. A static stdlib bundles the
# Swift runtime into the .so, matching how a shipping Android artifact looks.
rm -rf "$jni"
for abi in $abis; do
    case "$abi" in
        arm64-v8a) arch=aarch64 ;;
        x86_64) arch=x86_64 ;;
        *) echo "error: unknown ABI '$abi' in DAL_ANDROID_ABIS" >&2; exit 1 ;;
    esac
    resources="$bundle/swift-android/swift-resources/usr/lib/swift_static-$arch"
    swift build --scratch-path .build-androidtest -c release --product CoreAndroidTests \
        --swift-sdks-path "$sdkroot" --swift-sdk "$arch-unknown-linux-android$api" \
        -Xswiftc -static-stdlib -Xswiftc -resource-dir -Xswiftc "$resources"
    mkdir -p "$jni/$abi"
    # Locate the library rather than hardcoding a layout: Swift 6.4 emits
    # .build/out/Products/Release-android-<arch>/, older SwiftPM used
    # .build/<triple>/release/. Both spell the arch.
    built=$(find .build-androidtest -type f -name libCoreAndroidTests.so -path "*$arch*" -not -path "*/checkouts/*" 2> /dev/null | head -1)
    [ -n "$built" ] || { echo "error: libCoreAndroidTests.so for $arch not found under .build-androidtest" >&2; exit 1; }
    cp "$built" "$jni/$abi/"
    cxx=$(find "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt" -path "*$arch-linux-android*" -name libc++_shared.so 2> /dev/null | head -1)
    [ -n "$cxx" ] || { echo "error: libc++_shared.so for $arch not found in $ANDROID_NDK_HOME" >&2; exit 1; }
    cp "$cxx" "$jni/$abi/"
done
fi # end of staging

[ -n "${usage_stage_only:-}" ] && exit 0

./gradlew --no-daemon -p androidtest connectedAndroidTest

# Each model AAR's own instrumented suite, on the same booted device, in one
# Gradle invocation so the JVM/configuration cost is paid once. Gradle builds
# the model natives first (preBuild -> build:android-natives), so run
# `mise run build:android` before this if you want the two costs separated.
[ -n "${usage_core_only:-}" ] && exit 0
# The core AAR's own JVM tests (HostBridge, LoadedModel) run on the host, not
# the device, and nothing else runs them.
tasks=(":core:testDebugUnitTest")
for model in $(dal_select "${usage_model:-all}" kotlin); do
    # A pure-Kotlin module (no AndroidManifest.xml) has no instrumented suite:
    # its bytecode is what runs on the device, so its JVM tests are the check.
    if [ -f "packages/$model-kotlin/src/main/AndroidManifest.xml" ]; then
        tasks+=(":$model:connectedDebugAndroidTest")
    else
        tasks+=(":$model:test")
    fi
done
for name in HF_TOKEN DAL_HF_REPO_SUFFIX DAL_LICENSE_ENDPOINT EYE_BENCH EYE_BENCH_N UHM_BENCH UHM_BENCH_N; do
    if [ -n "${!name:-}" ]; then tasks+=("-Pandroid.testInstrumentationRunnerArguments.$name=${!name}"); fi
done
[ ${#tasks[@]} -eq 0 ] || ./gradlew --no-daemon "${tasks[@]}"
