#!/usr/bin/env bash
#MISE description="Provision the Android SDK and point Gradle at it"
#MISE dir="{{config_root}}"
#MISE hide=true
#MISE tools={java="{{ vars.java }}"}
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# Reuse a usable SDK already on the machine (Android Studio, a CI runner);
# otherwise vendor Google's command-line tools into .android-sdk. Either way,
# write local.properties, which is how Gradle finds the SDK - so no Android task
# needs ANDROID_HOME in the environment.
existing="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
if [ -n "$existing" ] && [ -d "$existing" ]; then sdk="$existing"; else sdk="$PWD/.android-sdk"; fi

# An installed sdkmanager can still be too old to parse android-37.0. The
# emulator action uses latest/bin explicitly, so update that copy too.
python3 Tools/android/environment.py provision --sdk "$sdk"
ext=""
[ "$(dal_host_os)" = windows ] && ext=".bat"
sdkmanager="$sdk/cmdline-tools/latest/bin/sdkmanager$ext"

# Every consumer below is a native tool (sdkmanager.bat, and Gradle reading
# local.properties), so they get the host's own spelling of the path; on Linux
# and macOS cygpath does not exist and $sdk already is that spelling.
sdk_native="$sdk"
command -v cygpath > /dev/null 2>&1 && sdk_native=$(cygpath -w "$sdk")

# Idempotent: sdkmanager no-ops on packages that are already installed.
# Take the platform from the same catalog as Gradle. Since API 37, the SDK
# package includes the minor version even for the base platform.
compile_sdk=$(sed -nE 's/^compileSdk[[:space:]]*=[[:space:]]*"([0-9]+)".*/\1/p' gradle/libs.versions.toml)
[ -n "$compile_sdk" ] || { echo "error: compileSdk missing from catalog" >&2; exit 1; }
platform="android-$compile_sdk"
[ "$compile_sdk" -lt 37 ] || platform="$platform.0"
# Build-tools 36.0.0 is the oldest AGP 9.5 accepts and its default.
export ANDROID_HOME="$sdk_native" ANDROID_SDK_ROOT="$sdk_native"
if [ ! -d "$sdk/platforms/$platform" ] || [ ! -d "$sdk/build-tools/36.0.0" ] \
    || [ ! -d "$sdk/platform-tools" ]; then
    echo "Installing the Android SDK packages ($platform, build-tools 36.0.0, platform-tools)..."
    yes | "$sdkmanager" --sdk_root="$sdk_native" --licenses > /dev/null 2>&1 || true
    "$sdkmanager" --sdk_root="$sdk_native" "platforms;$platform" "build-tools;36.0.0" platform-tools > /dev/null
fi

# The pinned NDK, side by side in this SDK, where both dal_android_ndk and AGP
# (ndkVersion) find it. Not on Windows: nothing there cross-compiles for Android
# (see build:android-natives), and an unpacked NDK is ~2 GB.
ndk_version=$(dal_android_ndk_version)
if [ "$(dal_host_os)" != windows ] && [ ! -f "$sdk/ndk/$ndk_version/source.properties" ]; then
    echo "Installing the Android NDK $ndk_version (one-time, ~1 GB download)..."
    yes | "$sdkmanager" --sdk_root="$sdk_native" --licenses > /dev/null 2>&1 || true
    "$sdkmanager" --sdk_root="$sdk_native" "ndk;$ndk_version" > /dev/null
fi

# Gradle reads this as a Java properties file, where a backslash escapes: a
# Windows path has to be written with forward slashes (Gradle accepts them) or
# every separator would be swallowed.
echo "sdk.dir=${sdk_native//\\//}" > local.properties
echo "sdk.dir=${sdk_native//\\//}" > androidconsumer/local.properties
echo "Android SDK ready: $sdk_native"
