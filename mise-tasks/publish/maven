#!/usr/bin/env bash
#MISE description="Publish every Maven artifact in this repo to Maven Central"
#MISE dir="{{config_root}}"
#MISE depends=["android-sdk", "check:version"]
#MISE tools={java="{{ vars.java }}"}
#USAGE flag "--local" help="Publish to ~/.m2 instead (keyless, for testing consumers)"
source "$MISE_PROJECT_ROOT/Tools/dal.sh"

# The Maven side of a release: ai.desertant:core and one artifact per model.
# The convention plugins are an included build and core is a project dependency
# (settings.gradle.kts), so nothing here waits for anything to appear on Central
# mid-release. The plugins themselves are not published: nothing outside this
# repo applies them. Versions up to 4.3.0 of
# ai.desertant:model-sdk-gradle-plugin stay on Central.
version=$(dal_version)

# Every publish here skips the configuration cache, --local included (it signs
# when a key is set): the signing key and the repository credentials arrive as
# Gradle properties that the build reads while it is configured, and a cache
# entry would keep them on disk. Encrypted, but these are the release keys, and
# a publish runs too rarely to gain anything from the cache.
if [ -n "${usage_local:-}" ]; then
    ./gradlew publishToMavenLocal --no-configuration-cache
    echo "published to ~/.m2: ai.desertant:* $version"
    exit 0
fi

# Everything below publishes for real, so every model AAR gets both ABIs,
# whatever the caller set. Local builds default to arm64-v8a alone (see
# dal_android_abis), and Gradle's preBuild rebuilds the natives with whatever
# is exported here. --local above keeps the caller's choice on purpose.
export DAL_ANDROID_ABIS="arm64-v8a x86_64"

if [ "${DAL_PUBLISH_TARGET:-}" = github ]; then
    tasks=(":core:publishAllPublicationsToGitHubPackagesRepository")
    for model in $(dal_models_with kotlin); do
        tasks+=(":$model:publishAllPublicationsToGitHubPackagesRepository")
    done
    ./gradlew "${tasks[@]}" --no-configuration-cache
    echo "published to GitHub Packages: ai.desertant:* $version"
    exit 0
fi

# Credentials arrive as Gradle properties through the environment, from CI
# secrets or mise.local.toml:
#   ORG_GRADLE_PROJECT_mavenCentralUsername / ...Password  (Central portal token)
#   ORG_GRADLE_PROJECT_signingInMemoryKey / ...KeyPassword (ASCII-armored GPG key)
: "${ORG_GRADLE_PROJECT_mavenCentralUsername:?set the Central portal token in mise.local.toml}"
: "${ORG_GRADLE_PROJECT_signingInMemoryKey:?set the in-memory GPG signing key in mise.local.toml}"

# Re-runnable: a tag whose release failed halfway re-runs every job, and Central
# rejects a duplicate version - which would hide whatever actually failed.
published() {
    curl -sfIL "https://repo1.maven.org/maven2/ai/desertant/$1/$version/$1-$version.pom" > /dev/null 2>&1
}

# One deployment for the whole Android build, so core and the models land
# together. Skip the artifacts already on Central; Central rejects a deployment
# that contains one.
projects=()
published core || projects+=(":core:publishAndReleaseToMavenCentral")
for model in $(dal_models_with kotlin); do
    published "$model" || projects+=(":$model:publishAndReleaseToMavenCentral")
done

if [ ${#projects[@]} -eq 0 ]; then
    echo "every Maven artifact is already published at $version"
else
    ./gradlew "${projects[@]}" --no-configuration-cache
fi
echo "published: ai.desertant:* $version"
