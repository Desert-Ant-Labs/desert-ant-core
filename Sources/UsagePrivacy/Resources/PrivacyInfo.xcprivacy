<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Apple requires a privacy manifest from any SDK that collects data or calls a
	  "required reason" API. The usage turnstile (the `Usage` target) does both, and
	  every model links it through DesertAnt (Title links it but sends nothing).
	  Where a model meters usage, the turnstile reports a generated device
	  identifier and a call count for licence metering, and it persists that
	  identifier and its re-emit state in UserDefaults. Without this file, apps
	  embedding the SDK can be rejected at App Store review.

	  No model input or output is ever reported: no text, audio, or results.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<!-- A v4 UUID generated on device, not IDFA/IDFV and not derived from
			     anything about the user or the hardware. -->
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<!-- `callCount`: how many times the app ran a model since the last send. -->
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<!-- The platform tag, the app's bundle id, and the SDK's name and
			     version. Each event's `context` adds the app version, the OS
			     name and version, the model identifier (such as iPhone16,2),
			     the form factor (desktop, mobile or tablet) and the
			     language-region locale; on the web, the browser name and major
			     version instead of the model. A native macOS app (reported as
			     a server), or an app given a device id by its caller or
			     DAL_DEVICE_ID, sends only the OS name, its major version and
			     the app version. No name, serial, screen or time zone. -->
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<!-- CA92.1: access to data stored by this app or its containing app
			     group. The turnstile reads and writes only its own
			     `ai.desertant.usage.*` keys. -->
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
