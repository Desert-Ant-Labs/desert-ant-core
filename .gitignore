mise.local.toml

# SwiftPM scratch directories, one per toolchain (see mise.toml): the Xcode,
# swift.org, and Android snapshot toolchains produce incompatible artifacts.
.build/
.build-host/
.build-android/
.build-androidtest/
.build-floor/
.build-xet/
.swiftpm/
Package.resolved
Vendor/

# Provisioned toolchains and SDK locations
.android-sdk/
local.properties

# Gradle. Listed per project rather than as **/build/, which would also swallow
# mise-tasks/build/.
.gradle/
**/.gradle/
/build/
kotlin/build/
gradle-plugin/build/
gradle-plugin/bin/
androidtest/build/
packages/*/build/
examples/**/build/

# npm workspace
node_modules/

# Generated by the build tasks into the model packages
packages/*/dist/
packages/*/native/
packages/*/natives/
packages/*/LICENSE.md
packages/*/test/fixtures/
packages/*/test/.model-cache/
packages/*/src/main/jniLibs/
packages/*/src/main/assets/
packages/*/src/main/resources/
# Tongue's jar resources are source, not build output: the bundled model is the
# artifact itself, checked in like the copies in Sources/Tongue/Resources and
# packages/tongue-node/src.
!packages/tongue-kotlin/src/main/resources/
kotlin/src/main/jniLibs/
androidtest/src/main/jniLibs/
js/LICENSE.md
*.wasm

.DS_Store
*.xcodeproj
xcuserdata/
*.xcuserstate
DerivedData/
